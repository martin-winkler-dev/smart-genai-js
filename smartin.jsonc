    "spdx": "Apache-2.0",
    "note": false,
    "fileHeader": false,
    "filter": ["*.ts", "*.mjs", "*.cjs"], // gitignore syntax, "!" excludes
    "packageBanner": true
  },
  "export": {
    "filter": ["*.ts", "package.json", "tsconfig*.json"] // gitignore syntax, "!" excludes
  },
  "spec": {
    "code": ["src/**/*.ts"], // gitignore syntax, "!" excludes
    "tests": ["tests/**/*.ts"], // gitignore syntax, "!" excludes
    "idLength": 4
  }
}
